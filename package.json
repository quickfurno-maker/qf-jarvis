{
  "name": "qf-jarvis",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "description": "QF Jarvis — the intelligence, recommendation, coordination, and founder decision-support layer for the QuickFurno ecosystem.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.18.0 <25.0.0"
  },
  "scripts": {
    "build": "tsc --build tsconfig.json && node scripts/copy-sql-assets.mjs",
    "clean": "node scripts/clean.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc --build tsconfig.json --pretty && pnpm --recursive --if-present run typecheck:tests",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.mjs",
    "test:watch": "vitest watch",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset:destroy-all-local-data": "docker compose down --volumes && docker compose up -d --wait",
    "db:migrate": "pnpm --filter @qf-jarvis/event-backbone db:migrate --",
    "db:preflight": "pnpm --filter @qf-jarvis/event-backbone db:preflight",
    "inspect:failures": "pnpm --filter @qf-jarvis/event-backbone inspect:failures --",
    "check:dist-containment": "node scripts/check-dist-containment.mjs",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run check:dist-containment && pnpm run check:scale:containers && pnpm run check:scale:coordination && pnpm run check:scale:durable-jobs && pnpm run check:scale:db-lifecycle && pnpm run check:scale:edge-origin && pnpm run check:scale:phase11 && pnpm run check:scale:phase12",
    "riya:as3:pilot": "node packages/riya-ai-synthetic-provider-adapters/dist/cli/bin.js",
    "check:scale:containers": "node scripts/scale/validate-container-contract.mjs",
    "test:scale:artifact": "node scripts/scale/validate-artifact-contract.mjs",
    "check:scale:coordination": "node scripts/scale/validate-coordination-contract.mjs",
    "check:scale:durable-jobs": "node scripts/scale/validate-durable-jobs-contract.mjs",
    "check:scale:db-lifecycle": "node scripts/scale/validate-db-lifecycle-contract.mjs",
    "test:scale:db-connection-budget": "node scripts/scale/certify-db-connection-budget-postgres.mjs",
    "test:scale:data-lifecycle-postgres": "node scripts/scale/certify-data-lifecycle-postgres.mjs",
    "test:scale:phase09": "pnpm run check:scale:db-lifecycle && pnpm run test:scale:db-connection-budget && pnpm run test:scale:data-lifecycle-postgres",
    "check:scale:edge-origin": "node scripts/scale/validate-edge-origin-contract.mjs",
    "check:scale:phase11": "node scripts/scale/validate-phase11-contract.mjs",
    "test:scale:phase11": "pnpm run check:scale:phase11 && vitest run packages/cross-system-scale-contract/src/tests/contract.test.ts packages/cross-system-scale-contract/src/tests/isolation.test.ts packages/core-decision-http-transport/src/tests/transport.test.ts apps/quickfurno-gateway/src/tests/server.test.ts apps/api/src/tests/private-riya-web-ingress.test.ts apps/api/src/tests/private-riya-qualification-ingress.test.ts apps/api/src/tests/private-riya-web-ingress-containment.test.ts apps/api/src/tests/quickfurno-whatsapp-http.test.ts apps/jarvis-os/src/server/control-plane/sources/quickfurno-operator-source.test.ts",
    "check:scale:phase12": "node scripts/scale/validate-phase12-horizontal-workers.mjs",
    "test:scale:phase12": "pnpm run check:scale:phase12 && vitest run apps/api/src/tests/quickfurno-whatsapp-parallel-turn-scheduler.test.ts apps/api/src/tests/quickfurno-whatsapp-production-worker.test.ts && vitest run --config vitest.integration.config.mjs apps/quickfurno-gateway/src/tests/postgres-durable-turn-spool.integration.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.9.2",
    "eslint": "10.6.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.7.0",
    "prettier": "3.9.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "vitest": "4.1.10"
  }
}
