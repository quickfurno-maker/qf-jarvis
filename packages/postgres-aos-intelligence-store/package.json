{
  "name": "@qf-jarvis/postgres-aos-intelligence-store",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "PostgreSQL durability for AOS shadow cases, recommendations, outcomes and exact behaviour manifests. Stores evidence; grants no authority.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "typecheck": "tsc --build tsconfig.build.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@qf-jarvis/aos-behaviour-control": "workspace:*",
    "@qf-jarvis/aos-intelligence": "workspace:*",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/pg": "8.20.0"
  }
}
