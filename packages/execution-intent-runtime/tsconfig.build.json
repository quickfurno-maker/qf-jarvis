{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./tsconfig.tsbuildinfo"
  },

  // The EMITTING build, referenced by the root solution. The vitest specs under src/tests are
  // EXCLUDED so nothing test-only reaches dist/. Exactly two project references: `contracts`, which
  // owns `executionIntentV1Schema` and the governed recommendation this package validates against,
  // and `approval-runtime`, whose PUBLIC validateDecision re-proves the approval evidence rather
  // than this package re-implementing it. There is no reference to persistence, to a transport, to
  // n8n, to a provider, or to any application -- a package that could reach one of those would be a
  // dispatcher, and this one correlates.
  "references": [
    { "path": "../../packages/contracts" },
    { "path": "../../packages/approval-runtime/tsconfig.build.json" }
  ],
  "include": ["src/**/*.ts"],
  "exclude": ["src/tests/**"]
}
