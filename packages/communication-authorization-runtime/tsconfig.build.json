{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./tsconfig.tsbuildinfo"
  },

  // The EMITTING build, referenced by the root solution. The vitest specs under src/tests are
  // EXCLUDED so nothing test-only reaches dist/. Exactly two project references: `contracts`, which
  // owns the communication request and authorization schemas this package validates against, and
  // `approval-runtime`, whose PUBLIC validateDecision is how approval evidence is re-proved rather
  // than re-implemented. There is no reference to persistence, to a transport, to an application, or
  // to anything that could reach a provider -- a correlation runtime that could send is not a
  // correlation runtime.
  "references": [
    { "path": "../../packages/contracts" },
    { "path": "../../packages/approval-runtime/tsconfig.build.json" }
  ],
  "include": ["src/**/*.ts"],
  "exclude": ["src/tests/**"]
}
