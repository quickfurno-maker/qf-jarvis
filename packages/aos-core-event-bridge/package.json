{
  "name": "@qf-jarvis/aos-core-event-bridge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Pure bridge from already-canonical QuickFurno Core events into bounded AOS shadow observations and behaviour triggers.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "typecheck": "tsc --build tsconfig.build.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@qf-jarvis/aos-intelligence": "workspace:*",
    "@qf-jarvis/client-intelligence": "workspace:*",
    "@qf-jarvis/contracts": "workspace:*"
  }
}
