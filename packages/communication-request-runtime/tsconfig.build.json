{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./tsconfig.tsbuildinfo"
  },

  // The EMITTING build, referenced by the root solution. The vitest specs under src/tests are
  // EXCLUDED so nothing test-only reaches dist/. Exactly two project references: `contracts`, which
  // owns `communicationRequestV1Schema` and every schema this package validates against, and
  // `recommendation-runtime`, whose PUBLIC `fingerprintProposedAction` is how a supplied binding is
  // re-proved. It knows nothing of the approval runtime, the communication-authorization runtime,
  // the agent runtime, the composition root, Core, persistence, n8n or any provider -- a
  // communication request is powerless, and a package that could reach any of those would not be.
  "references": [
    { "path": "../../packages/contracts" },
    { "path": "../../packages/recommendation-runtime/tsconfig.build.json" }
  ],
  "include": ["src/**/*.ts"],
  "exclude": ["src/tests/**"]
}
