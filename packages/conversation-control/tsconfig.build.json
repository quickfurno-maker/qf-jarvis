{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./tsconfig.tsbuildinfo"
  },

  // The EMITTING build, referenced by the root solution. The vitest specs under src/tests are
  // EXCLUDED so nothing test-only reaches dist/. NO project references at all: this is a true leaf.
  // It knows nothing of the agent runtime, the composition root, Core, the gateway, providers or
  // transport -- which is what lets QFJ-P08-A PR 2 compose it without inverting anything.
  "references": [],
  "include": ["src/**/*.ts"],
  "exclude": ["src/tests/**"]
}
