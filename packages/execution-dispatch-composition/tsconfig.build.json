{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./tsconfig.tsbuildinfo"
  },

  // The EMITTING build. Specs under src/tests are EXCLUDED so nothing test-only reaches dist/.
  // Two project references, both INWARD: this composition depends on the dispatch boundary and on
  // the durable store, and neither depends back on it. That direction is the containment.
  "references": [
    { "path": "../execution-dispatch-runtime/tsconfig.build.json" },
    { "path": "../postgres-execution-replay-store/tsconfig.build.json" }
  ],
  "include": ["src/**/*.ts"],
  "exclude": ["src/tests/**"]
}
