{
  "name": "@qf-jarvis/operator-client-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Framework-neutral Jarvis OS operator client core shared by web and future native mobile clients.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "typecheck": "tsc --build tsconfig.build.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@qf-jarvis/control-plane-read-contract": "workspace:*",
    "@qf-jarvis/operator-api-contract": "workspace:*"
  }
}
