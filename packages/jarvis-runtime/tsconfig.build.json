{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./tsconfig.tsbuildinfo"
  },

  // The EMITTING build, referenced by the root solution. The vitest specs under src/tests
  // are EXCLUDED so nothing test-only reaches dist/; the shipped test support under
  // src/testing IS emitted (the public `./testing` subpath). Project references: the
  // composition root wires @qf-jarvis/agent-runtime (M1/M2 ports + orchestrator),
  // @qf-jarvis/core-decision-adapter (M3), @qf-jarvis/model-reply-adapter (M4), and
  // @qf-jarvis/riya-agent (S3-C) and @qf-jarvis/anisha-agent (S3-D) — all one-way, and both
  // behaviour packages depend only on
  // agent-runtime, so the graph stays acyclic. QFJ-P08-A (ADR-0075) adds
  // @qf-jarvis/conversation-control, a zod-only leaf, for the operator control surface.
  "references": [
    { "path": "../agent-runtime/tsconfig.build.json" },
    { "path": "../core-decision-adapter/tsconfig.build.json" },
    { "path": "../model-reply-adapter/tsconfig.build.json" },
    { "path": "../riya-agent/tsconfig.build.json" },
    // RWC-P4B (ADR-0099): the Riya-aware inbound capability. The continuity contract and the
    // pure RWC-P4A reducer are named as TYPES for the capability result; `riya-model-interaction`
    // supplies the structured-output profile handed to the one M4 adapter.
    { "path": "../riya-conversation-continuity/tsconfig.build.json" },
    { "path": "../riya-conversation-evolution/tsconfig.build.json" },
    { "path": "../riya-model-interaction/tsconfig.build.json" },
    // RWC-P5 (ADR-0100): the Core-owned availability READ contract, for the parser this
    // composition re-proves its Riya-aware input against. The runtime performs NO Core read --
    // the snapshot is supplied by the service that owns the outbound call, exactly as the
    // continuity is supplied by the service that owns the store.
    { "path": "../core-service-availability-read/tsconfig.build.json" },
    { "path": "../anisha-agent/tsconfig.build.json" },
    { "path": "../prompt-registry/tsconfig.build.json" },
    { "path": "../conversation-control/tsconfig.build.json" }
  ],
  "include": ["src/**/*.ts"],
  "exclude": ["src/tests/**"]
}
