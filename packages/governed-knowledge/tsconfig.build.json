{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./tsconfig.tsbuildinfo"
  },

  // The EMITTING build, referenced by the root solution. The vitest specs under
  // src/tests are EXCLUDED so nothing test-only reaches dist/; the shipped test
  // support (the deterministic privacy gate under src/testing) IS emitted because
  // it is the public `./testing` subpath. Tests are type-checked, without emit, by
  // tsconfig.json. The package depends only on zod — no project references.
  "include": ["src/**/*.ts"],
  "exclude": ["src/tests/**"]
}
