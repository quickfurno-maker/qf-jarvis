{
  "name": "@qf-jarvis/typesafe-jev-adapter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Pinned TypeSafe Jev System-One HTTP adapter for the advisory-only Jarvis decision runtime. No action, approval, Core or database authority.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "typecheck": "tsc --build tsconfig.build.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@qf-jarvis/system-one-decision-runtime": "workspace:*"
  }
}
