{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./tsconfig.tsbuildinfo"
  },

  // The EMITTING build, referenced by the root solution. The vitest specs under src/tests
  // are EXCLUDED so nothing test-only reaches dist/; the shipped test support under
  // src/testing IS emitted (the public `./testing` subpath). Project references: the adapter
  // composes @qf-jarvis/agent-runtime (ModelReplyPort/contracts) and @qf-jarvis/model-gateway
  // (public request/response/provenance contracts) — both one-way.
  "references": [
    { "path": "../agent-runtime/tsconfig.build.json" },
    { "path": "../model-gateway" }
  ],
  "include": ["src/**/*.ts"],
  "exclude": ["src/tests/**"]
}
