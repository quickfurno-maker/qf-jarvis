{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./tsconfig.tsbuildinfo"
  },

  // The EMITTING build. Specs under src/tests are excluded so nothing test-only reaches dist/.
  //
  // ONE reference, and it is the minimum: `prompt-registry` owns the constructor that computes the
  // digest, so the identity is bound by the same code the reply adapter verifies against.
  //
  // Deliberately absent: `model-gateway` and every provider, `jarvis-runtime`, the agent's own domain
  // package, every app, every evaluation package, and anything Postgres. A prompt definition reaches
  // none of them, and depending on the domain package would let a prompt import business logic.
  "references": [{ "path": "../prompt-registry/tsconfig.build.json" }],
  "include": ["src/**/*.ts"],
  "exclude": ["src/tests/**"]
}
