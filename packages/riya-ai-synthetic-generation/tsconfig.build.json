{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./tsconfig.tsbuildinfo"
  },

  // The EMITTING build. Specs under src/tests are EXCLUDED so nothing test-only -- including the
  // deterministic fake adapters' expectations -- reaches dist/.
  //
  // TWO project references, both one-way. `riya-intelligence-dataset` owns the AS1 scenario,
  // provenance, critic, evidence and acceptance contracts this harness ASSEMBLES rather than forks --
  // a second acceptance implementation beside AS1's would be a gate nobody could compare.
  // `riya-conversation-continuity` owns the phase vocabulary the scheduler plans against.
  //
  // Deliberately absent, each for its own reason: `model-gateway`, `jarvis-runtime`,
  // `agent-runtime`, `riya-model-interaction` and `riya-web-conversation-service` (this is OFFLINE
  // dataset generation -- importing production serving composition would drag in routing policy,
  // live credentials, customer authority state and failover, none of which belongs in a corpus
  // build), `model-evaluation` (the protected exam reaches the AS1 VALIDATOR, never the generator),
  // `prompt-registry` and `governed-knowledge` (authoritative context here is SIMULATED, never a
  // lookup), and anything Postgres or `event-backbone` (no I/O, no migration).
  "references": [
    { "path": "../riya-conversation-continuity/tsconfig.build.json" },
    { "path": "../riya-intelligence-dataset/tsconfig.build.json" }
  ],
  "include": ["src/**/*.ts"],
  "exclude": ["src/tests/**"]
}
