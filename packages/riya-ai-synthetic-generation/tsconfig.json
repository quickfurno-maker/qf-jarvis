{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Type-check EVERYTHING -- production source and the vitest specs -- under full strict mode, but
    // emit nothing. `composite` must be off because it requires emit; the emitting build
    // (tsconfig.build.json) excludes src/tests.
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "incremental": false
  },
  "include": ["src/**/*.ts"]
}
