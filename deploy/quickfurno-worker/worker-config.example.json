{
  "schemaVersion": 1,
  "environment": "production",
  "serviceId": "qf-jarvis.whatsapp-worker",
  "revision": "0000000000000000000000000000000000000000",
  "deploymentMode": "SINGLE_OWNER",
  "database": {
    "connectionString": "postgresql://REPLACE_AT_DEPLOYMENT",
    "maxConnections": 5,
    "connectionTimeoutMillis": 10000,
    "idleTimeoutMillis": 30000,
    "statementTimeoutMillis": 30000,
    "tls": {
      "mode": "verify-full",
      "caFile": "/run/secrets/postgres-ca.pem"
    }
  },
  "turnStore": {
    "mode": "POSTGRES"
  },
  "sealFile": "/run/secrets/jf5c-production-seal.json",
  "groqCredentialReference": "groq.qfj.production.v1",
  "groqCredentialFile": "/run/secrets/groq-production.key",
  "quickfurno": {
    "baseUrl": "https://REPLACE_AT_DEPLOYMENT/",
    "keyId": "REPLACE_AT_DEPLOYMENT",
    "privateKeyFile": "/run/secrets/quickfurno-signing.key",
    "timeoutMs": 5000
  },
  "knowledge": {
    "mode": "DISABLED"
  },
  "decisionIntelligence": {
    "mode": "DISABLED"
  },
  "aosShadow": {
    "mode": "SHADOW",
    "cadenceMs": 900000,
    "ownerAttentionObservationFile": "/var/run/qfj-observability/aos-owner-attention.json",
    "marketCapacityObservationFile": "/var/run/qfj-observability/aos-market-capacity.json"
  },
  "concurrency": {
    "globalMaxConcurrentTurns": 200,
    "maxConcurrentByAgent": {
      "RIYA": 200,
      "ANISHA": 200,
      "AAROHI": 200
    },
    "modelGateway": {
      "maxConcurrent": 50,
      "maxQueue": 150
    }
  },
  "killSwitchFile": "/var/run/qfj-control/DISABLE_MODEL",
  "operationalSnapshotFile": "/var/run/qfj-observability/whatsapp-worker.json",
  "agentFlowTraceSnapshotFile": "/var/run/qfj-observability/agent-flow-trace.json",
  "runtimeId": "qfj.whatsapp.production.v1",
  "policyRevision": "policy.quickfurno.production.v1",
  "idlePollMs": 500,
  "staleProcessingMs": 300000
}
