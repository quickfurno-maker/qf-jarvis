#!/usr/bin/env bash
set -Eeuo pipefail
CONTROL_ROOT='/srv/qf-jarvis/release-control'
CONTROLLER="$CONTROL_ROOT/deploy/phase15/release.sh"
die(){ echo "QFJ_PHASE15_WRAPPER_REFUSED: $1" >&2; exit 1; }
[[ "$(id -u)" -eq 0 ]] || die "must execute as root"
for path in "$CONTROL_ROOT" "$CONTROLLER"; do
  [[ ! -L "$path" ]] || die "$path must not be a symlink"
  [[ "$(stat -c '%u' "$path")" == "0" ]] || die "$path must be root-owned"
  perms="$(stat -c '%A' "$path")"
  [[ "${perms:5:1}" != "w" && "${perms:8:1}" != "w" ]] || die "$path must not be group/world writable"
done
[[ -x "$CONTROLLER" ]] || die "controller is not executable"
case "${1:-}" in stage|promote|rollback|reconcile-bootstrap|status) ;; *) die "command not allowlisted" ;; esac
exec "$CONTROLLER" "$@"
