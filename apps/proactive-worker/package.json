{
  "name": "@qf-jarvis/proactive-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Dormant-by-default SHADOW proactive scheduler for governed JAO ambient operations. It owns no business authority and cannot activate an effect.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "typecheck": "tsc --build tsconfig.build.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@qf-jarvis/aos-behaviour-control": "workspace:*",
    "@qf-jarvis/aos-core-event-bridge": "workspace:*",
    "@qf-jarvis/aos-governance-integration": "workspace:*",
    "@qf-jarvis/aos-intelligence": "workspace:*",
    "@qf-jarvis/aos-model-reasoning": "workspace:*",
    "@qf-jarvis/event-backbone": "workspace:*",
    "@qf-jarvis/model-gateway": "workspace:*",
    "@qf-jarvis/worker": "workspace:*"
  }
}
