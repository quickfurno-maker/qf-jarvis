{
  "name": "@qf-jarvis/livekit-voice-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "LiveKit transport-only operator-voice participant for Jarvis. It carries realtime audio only and holds no model, inference, Core or execution authority.",
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "start": "node dist/agent.js start",
    "typecheck": "tsc --build tsconfig.build.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@livekit/agents": "1.9.0",
    "@livekit/rtc-node": "0.13.35",
    "@qf-jarvis/operator-api-contract": "workspace:*",
    "zod": "4.4.3"
  }
}
