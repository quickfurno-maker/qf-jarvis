{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./tsconfig.tsbuildinfo"
  },

  // The EMITTING build, referenced by the root solution. Tests are EXCLUDED so nothing from src/tests
  // reaches dist/ — mirroring apps/worker. The project reference makes `tsc --build` compile
  // @qf-jarvis/model-gateway first, so the existing GroqCredentialResolver / GroqApiKey declarations
  // resolve. Tests are type-checked, without emit, by tsconfig.json (typecheck:tests).
  "references": [
    { "path": "../../packages/model-gateway" },
    { "path": "../../packages/model-evaluation/tsconfig.build.json" },
    { "path": "../../packages/model-gateway-composition/tsconfig.build.json" },
    { "path": "../../packages/prompt-registry/tsconfig.build.json" },
    // QFJ-P08-B3 (ADR-0078): the durable runtime composition module. These three are the only new
    // production edges, and they exist solely so `src/runtime/durable-jarvis-runtime.ts` can create a
    // pool, build the durable adapter, and compose the runtime.
    // `event-backbone` has no separate emitting project; its root tsconfig is the build, exactly as
    // `model-gateway` above is referenced.
    { "path": "../../packages/event-backbone" },
    { "path": "../../packages/jarvis-runtime/tsconfig.build.json" },
    { "path": "../../packages/postgres-conversation-state/tsconfig.build.json" },
    // JF-6 final QuickFurno integration: the serving Riya composition reuses the already-reviewed
    // durable continuity store and turn coordinator. Both receive the caller-owned pool; neither
    // creates a connection or reads deployment configuration on import.
    { "path": "../../packages/postgres-riya-conversation-continuity-store/tsconfig.build.json" },
    { "path": "../../packages/postgres-riya-turn-coordinator/tsconfig.build.json" },
    // QFJ-P08 (ADR-0082): the authenticated operator boundary. `contracts` is a real runtime edge --
    // the service validates an identifier and two instants with the governed schemas -- while the
    // approval adapter and the durable queue are named as TYPES ONLY: both are INJECTED, so the
    // service composes them without importing a line of either at runtime.
    { "path": "../../packages/contracts" },
    { "path": "../../packages/approval-core-adapter/tsconfig.build.json" },
    { "path": "../../packages/postgres-approval-queue/tsconfig.build.json" },
    // ADR-0097: the private Riya web ingress. Two edges, both genuinely used -- the conversation
    // SERVICE the handler delegates to, and `agent-runtime` for the closed `RUNTIME_DATA_CLASSES`
    // vocabulary the classification-policy output is validated against.
    { "path": "../../packages/riya-web-conversation-service/tsconfig.build.json" },
    { "path": "../../packages/agent-runtime/tsconfig.build.json" },
    { "path": "../../packages/action-kernel/tsconfig.build.json" },
    { "path": "../../packages/durable-orchestration-contracts/tsconfig.build.json" },
    // JF-4 (ADR-0149): the customer orchestration boundary. `rag-provisioning` is the JF-3
    // provisioning boundary the governed-RAG port calls, and `governed-knowledge` supplies the
    // request/result TYPES that port adapts between. Neither adds a knowledge authority here -- the
    // authority stays inside governed-knowledge, reached through JF-3.
    { "path": "../../packages/rag-provisioning/tsconfig.build.json" },
    { "path": "../../packages/governed-knowledge/tsconfig.build.json" },

    // JF-5B (ADR-0152): the offline certification bin. The harness is the evaluation-only library and
    // re-exports the three reviewed prompt definitions the six bindings pin; `riya-prompts` is named
    // directly because her dedicated capability needs all three of her task-class variants registered;
    // the Groq smoke is reused for connectivity and for the masked-TTY secret primitive; the
    // core-decision adapter supplies the synthetic certification Core boundary; the model-reply adapter
    // supplies the invoker and prompt-binding TYPES the runtime configuration is built from.
    // Reachable ONLY from src/bin/run-jf5b-live-certification.ts.
    { "path": "../../packages/jarvis-v1-production-profile/tsconfig.build.json" },
    { "path": "../../packages/jarvis-v1-production-seal/tsconfig.build.json" },
    { "path": "../../packages/jarvis-v1-provider-certification-live/tsconfig.build.json" },
    { "path": "../../packages/groq-staging-smoke/tsconfig.build.json" },
    { "path": "../../packages/core-decision-adapter/tsconfig.build.json" },
    { "path": "../../packages/core-decision-http-transport/tsconfig.build.json" },
    { "path": "../../packages/model-reply-adapter/tsconfig.build.json" },
    { "path": "../../packages/riya-prompts/tsconfig.build.json" },
    // The synthetic certification context builds its Core availability snapshot through that
    // package's OWN public parser rather than casting a hand-written object into its contract. One
    // edge, used only by the certification composition.
    { "path": "../../packages/core-service-availability-read/tsconfig.build.json" },
    // JF-7 production WhatsApp worker consumes the exact same durable spool implementation the
    // QuickFurno ingress writes. Only the explicit durable-turn-spool subpath is importable.
    { "path": "../quickfurno-gateway/tsconfig.build.json" }
  ],
  "include": ["src/**/*.ts"],
  "exclude": ["src/tests/**"]
}
