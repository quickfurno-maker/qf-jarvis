{
  "name": "@qf-jarvis/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "QF Jarvis API application boundary. QFJ-S2-D-B (ADR-0064) made this the process boundary that acquires the production Groq model-inference credential from a mounted file. QFJ-S2-E-B (ADR-0065) adds two internal one-shot executables: a deterministic offline SHADOW evidence generator, and a controlled SHADOW runner that composes the existing gateway with a process-local rollout controller, resolves one credential, builds two Groq providers, transitions OFF->SHADOW->OFF, discards every model output, and enforces a hard call budget. Reusable packages receive configuration explicitly and read no environment; only an executable process boundary acquires deployment configuration. This application reads no process.env, exports nothing from its package root, and activates nothing by itself.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "typecheck": "tsc --build tsconfig.build.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.json",
    "start:quickfurno-whatsapp-worker": "node ./dist/bin/run-quickfurno-whatsapp-production-worker.js"
  },
  "dependencies": {
    "@mastra/core": "1.61.0",
    "@qf-jarvis/agent-runtime": "workspace:*",
    "@qf-jarvis/approval-core-adapter": "workspace:*",
    "@qf-jarvis/contracts": "workspace:*",
    "@qf-jarvis/core-decision-adapter": "workspace:*",
    "@qf-jarvis/core-decision-http-transport": "workspace:*",
    "@qf-jarvis/core-service-availability-read": "workspace:*",
    "@qf-jarvis/event-backbone": "workspace:*",
    "@qf-jarvis/governed-knowledge": "workspace:*",
    "@qf-jarvis/groq-staging-smoke": "workspace:*",
    "@qf-jarvis/jarvis-runtime": "workspace:*",
    "@qf-jarvis/jarvis-v1-production-profile": "workspace:*",
    "@qf-jarvis/jarvis-v1-production-seal": "workspace:*",
    "@qf-jarvis/jarvis-v1-provider-certification-live": "workspace:*",
    "@qf-jarvis/model-evaluation": "workspace:*",
    "@qf-jarvis/model-gateway": "workspace:*",
    "@qf-jarvis/model-gateway-composition": "workspace:*",
    "@qf-jarvis/model-reply-adapter": "workspace:*",
    "@qf-jarvis/postgres-approval-queue": "workspace:*",
    "@qf-jarvis/postgres-conversation-state": "workspace:*",
    "@qf-jarvis/postgres-riya-conversation-continuity-store": "workspace:*",
    "@qf-jarvis/postgres-riya-turn-coordinator": "workspace:*",
    "@qf-jarvis/prompt-registry": "workspace:*",
    "@qf-jarvis/quickfurno-gateway": "workspace:*",
    "@qf-jarvis/rag-provisioning": "workspace:*",
    "@qf-jarvis/riya-prompts": "workspace:*",
    "@qf-jarvis/riya-web-conversation-service": "workspace:*",
    "zod": "4.4.3",
    "@qf-jarvis/action-kernel": "workspace:*",
    "@qf-jarvis/durable-orchestration-contracts": "workspace:*",
    "@temporalio/client": "1.24.0"
  },
  "devDependencies": {
    "@qf-jarvis/approval-runtime": "workspace:*",
    "@qf-jarvis/conversation-control": "workspace:*",
    "@qf-jarvis/recommendation-runtime": "workspace:*"
  },
  "bin": {
    "qfj-generate-shadow-evidence": "./dist/bin/generate-shadow-evidence.js",
    "qfj-jf5b-certify": "./dist/bin/run-jf5b-live-certification.js",
    "qfj-run-shadow-once": "./dist/bin/run-shadow-once.js"
  }
}
